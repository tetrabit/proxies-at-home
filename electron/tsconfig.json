{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "incremental": false,
        "noEmit": true,
        "rootDir": "..",
        "declaration": false,
        "resolveJsonModule": true
    },
    "include": [
        "main.ts",
        "preload.cts",
        "preload-api.ts",
        "mpc-preferences.ts",
        "calibration-harness-ipc.ts",
        "../shared/calibrationHarnessIpc.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
